# Copy to .env in your working folder, or to ~/.config/fsgen/.env for every folder.
# Onshape API keys: My Account -> Developer -> API keys (only "read" and "write" documents are needed).
# On macOS, `fsgen keys store` moves them into the Keychain; macOS then asks before each run that uses them.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_BASE_URL=https://cad.onshape.com

# API budget tracking (EDU plans: 2500 calls/year). Record Onshape's official count with
# `fsgen usage --set-official N`; fsgen adds its own logged calls on top.
ONSHAPE_API_ALLOCATION=2500
ONSHAPE_API_BASELINE=0
ONSHAPE_API_BASELINE_DATE=
ONSHAPE_RUN_BUDGET=60
# Calls per day across all runs (counted from the ledger); fsgen refuses more until you raise it.
FSGEN_DAILY_BUDGET=60
# macOS notification after each run that used the API (0 = off)
# FSGEN_NOTIFY=1

# Variables: one Variable Studio ("studio", default) or Variable features in the tree ("tree")
# FSGEN_VARIABLES=studio

# Optional: copy outputs to a synced folder (e.g. Dropbox, visible in Onshape's cloud import)
# FSGEN_DROPBOX_DIR=/path/to/Dropbox/fsgen

# LLM for `fsgen generate` (default: the logged-in `claude` CLI)
# ANTHROPIC_API_KEY=                                   # use the Anthropic API instead
# FSGEN_LLM_COMMAND=ollama run qwen2.5-coder:32b       # or any LLM CLI: prompt on stdin, answer on stdout
